<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".ui.medico.fragments.LobbyMedicoFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <!-- Logo -->
        <ImageView
            android:id="@+id/imageLogo"
            android:layout_width="160dp"
            android:layout_height="140dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/logo_android"
            android:layout_marginBottom="12dp" />

        <!-- Título -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Painel do Médico"
            android:textStyle="bold"
            android:textSize="22sp"
            android:layout_marginBottom="20dp" />

        <!-- Label Consultas -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Consultas Futuras"
            android:textStyle="bold"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
            android:layout_marginBottom="8dp" />

        <!-- Spinner de Consultas -->
        <Spinner
            android:id="@+id/spinnerConsultas"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="16dp"
            android:background="?attr/colorSurfaceVariant"
            android:padding="4dp" />

        <!-- Label Paciente -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Paciente:"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
            android:layout_marginBottom="6dp" />

        <!-- Nome do Paciente -->
        <TextView
            android:id="@+id/textPaciente"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Selecione uma consulta"
            android:textStyle="bold"
            android:padding="10dp"
            android:background="?attr/colorSurfaceVariant"
            android:layout_marginBottom="24dp" />

        <!-- Botão: Ver Prontuário -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnProntuario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ver Prontuário"
            android:layout_marginBottom="12dp"
            app:icon="@drawable/ic_description"
            app:iconGravity="textStart" />

        <!-- Botão: Realizar Consulta -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRealizarConsulta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Realizar Consulta"
            android:layout_marginBottom="12dp"
            app:icon="@drawable/ic_medical_services"
            app:iconGravity="textStart" />

        <!-- Botão: Logout -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogout"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sair" />

    </LinearLayout>
</ScrollView>
