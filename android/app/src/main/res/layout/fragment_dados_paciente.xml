<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Botão voltar -->
        <ImageView
            android:id="@+id/btnReturn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="start"
            android:layout_marginTop="10dp"
            android:layout_marginStart="16dp"
            android:src="@drawable/ic_voltar"
            android:contentDescription="@string/fragment_dados_paciente_btn_voltar" />

        <!-- Logo -->
        <ImageView
            android:layout_width="180dp"
            android:layout_height="160dp"
            android:layout_gravity="center_horizontal"
            android:src="@drawable/logo_android"
            android:contentDescription="@string/fragment_dados_paciente_logo_content_desc" />

        <!-- Retângulo de informações -->
        <LinearLayout
            android:orientation="vertical"
            android:layout_marginTop="24dp"
            android:padding="16dp"
            android:background="@drawable/bg_retangulo_dados"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- CPF -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ic_cpf"
                    app:tint="@color/colorPrimary"
                    android:contentDescription="@string/fragment_dados_paciente_icon_cpf_desc" />

                <TextView
                    android:id="@+id/tvCpf"
                    android:text="@string/fragment_dados_paciente_label_cpf"
                    android:textStyle="bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- Nome -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ic_user"
                    app:tint="@color/colorPrimary"
                    android:contentDescription="@string/fragment_dados_paciente_icon_nome_desc" />

                <TextView
                    android:id="@+id/tvNome"
                    android:text="@string/fragment_dados_paciente_label_nome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- Email -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ic_email"
                    app:tint="@color/colorPrimary"
                    android:contentDescription="@string/fragment_dados_paciente_icon_email_desc" />

                <TextView
                    android:id="@+id/tvEmail"
                    android:text="@string/fragment_dados_paciente_label_email"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
