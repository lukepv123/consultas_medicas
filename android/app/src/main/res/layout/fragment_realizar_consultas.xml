<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Botão Voltar -->
        <ImageView
            android:id="@+id/btnReturn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="16dp"
            android:layout_gravity="start"
            android:contentDescription="@string/fragment_minhas_consultas_paciente_btn_voltar"
            android:src="@drawable/ic_voltar"
            android:layout_marginTop="10dp"/>

        <ImageView
            android:layout_width="180dp"
            android:layout_height="160dp"
            android:layout_gravity="center_horizontal"
            android:contentDescription="@string/fragment_minhas_consultas_paciente_logo_app"
            android:src="@drawable/logo_android"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="12dp" />

        <!-- Campos de Entrada -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Possui alergias?">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputAlergias"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Possui deficiência?">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputDeficiencia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Doenças pré-existentes?">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputComorbidade"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Solicitar exames">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputExames"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Medicação">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputMedicacao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Atendimento">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputAtendimento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Espaço -->
        <View
            android:layout_width="match_parent"
            android:layout_height="16dp" />

        <!-- Botões de Ação -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConcluir"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Concluir Consulta"
            app:iconGravity="textStart" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEnviarEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enviar Receita por E-mail"
            app:icon="@drawable/ic_email"
            app:iconGravity="textStart"
            android:layout_marginTop="8dp" />

    </LinearLayout>
</ScrollView>
